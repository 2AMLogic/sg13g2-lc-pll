* sg13g2-lc-pll :: sim/pfd -- PFD phase-error sweep at 50 MHz, PFD driving the charge pump.
* ONE transient. REF is a fixed 50 MHz clock. FB is a PWL source whose rising edge in
* cycle k is delayed by phi_k relative to REF's (generated by scripts/run-pfd-sweep.sh from
* a stepped schedule: 10 ps steps for |phi| <= 1 ns, 50 ps to 3 ns, 250 ps to T_ref/2).
* The charge pump output is held at 2.0 V (inside the flat part of the CP window) by an
* ideal source; the current into that source, integrated per cycle, is the CP charge.
* Placeholders (@@...@@) are filled by scripts/run-pfd-sweep.sh; nothing else is substituted.
.lib @@MODELS_DIR@@/cornerMOShv.lib mos_tt
.option scale=1 temp=27
.include @@PFD_NETLIST@@
.include @@CP_NETLIST@@
.include @@FB_FILE@@

VDD vdd 0 3.3
VREF ref 0 PULSE(0 3.3 20n 100p 100p 4.9n 20n)
XPFD ref fb up dn vdd 0 pfd
XCP up dn iref vo vdd 0 cp
IREF vdd iref dc 20u
VO vo 0 2.0

.options reltol=1e-3 abstol=1e-10 vntol=1e-5 chgtol=1e-14

.control
pre_osdi @@OSDI_PSP@@
tran 25p @@TSTOP@@ 0 25p
* i(VO): current into the + node of VO = sourced by the CP (UP positive).
wrdata @@DATA_OUT@@ i(VO)
.endc
.end
