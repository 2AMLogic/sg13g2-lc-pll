* sg13g2-lc-pll :: sim/prescaler-g3 (chain) -- whole prescaler, both modulus states (gate G3 evidence).
* NOMINAL ONLY: hbt_typ, 27 C, 3.3 V. One transient per (input frequency, MC): the first stage
* (div89_dm / cml_div23, /2 or /3) sees the full input, followed by a fixed /4. MC = 0 -> total /8,
* MC = 3.3 V -> total /9 (needs MC at or above about 0.94 VDD, DR-005; 3.3 V satisfies it). Placeholders (@@...@@) are filled by scripts/run-prescaler-g3.sh.
.lib @@MODELS_DIR@@/cornerHBT.lib hbt_typ
.lib @@MODELS_DIR@@/cornerRES.lib res_typ
.option temp=27
.include @@PRESC_NETLIST@@

VDD vdd 0 3.3
IRF vdd iref dc 50u
VMC mc 0 dc 0
X1 inp inn mc iref outp outn vdd 0 prescaler
VIP inp 0 dc 3.3 sin(3.3 @@AMP@@ @@FIN@@)
VIN inn 0 dc 3.3 sin(3.3 -@@AMP@@ @@FIN@@)
.ic v(x1.hp)=3.2 v(x1.hn)=3.0 v(x1.x2.mp)=3.0 v(x1.x2.mn)=3.2
.save v(outp) v(outn) v(x1.hp) v(x1.hn)

.control
pre_osdi @@OSDI_R3@@
foreach f @@FLIST@@
  alter vip sin = [ 3.3 @@AMP@@ $f ]
  alter vin sin = [ 3.3 -@@AMP@@ $f ]
  alter vmc dc = 0
  tran 1p @@TRAN_STOP@@ 0 2p
  wrdata @@OUT_DIR@@/mc0_$f v(outp)-v(outn)
  alter vmc dc = 3.3
  tran 1p @@TRAN_STOP@@ 0 2p
  wrdata @@OUT_DIR@@/mc1_$f v(outp)-v(outn)
end
.endc
.end
