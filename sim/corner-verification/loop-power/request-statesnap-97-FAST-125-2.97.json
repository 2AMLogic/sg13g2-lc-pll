{
 "_comment": [
  "Item 5 corner envelope, spec row 11 (loop power excluding the VCO core), stage 2 of the spec C-grid.",
  "Circuit: CML prescaler + M/A divider at N = 100 driven at 5.0 GHz (design/netlist/{prescaler,divider}.spice). PFD + CP + bias, lock detector, reference and clock buffering are NOT in this circuit.",
  "Per corner: ipavg / idavg = mean supply current of each rail over 40n-120n; tfb = 3 FB periods (rise 1 to rise 4 after 40n); 3 x 19.5-20.5 ns means the divider divides to 50 MHz.",
  "Power limits are NOT set on the requests: the 20 mW budget needs PFD+CP+bias added and the owed blocks; the record grades it.",
  "Issue #97 counter state snapshot at 50 ns, FAST 125 C 2.97 V."
 ],
 "netlist": "loop_power_body.spice",
 "netlist_source": "schematic",
 "engine": "ngspice",
 "backend": "batch",
 "models": {
  "pdk": "ihp-sg13g2"
 },
 "analysis": {
  "kind": "tran",
  "args": "4p 62n 0 4p"
 },
 "measurements": [
  {
   "name": "tc_at",
   "unit": "V",
   "on_unreached": "null",
   "spice": ".meas tran tc_at find v(xdiv.tc) at=50n"
  },
  {
   "name": "tcn_at",
   "unit": "V",
   "on_unreached": "null",
   "spice": ".meas tran tcn_at find v(xdiv.tcn) at=50n"
  },
  {
   "name": "q0_at",
   "unit": "V",
   "on_unreached": "null",
   "spice": ".meas tran q0_at find v(xdiv.xm.q0) at=50n"
  },
  {
   "name": "q1_at",
   "unit": "V",
   "on_unreached": "null",
   "spice": ".meas tran q1_at find v(xdiv.xm.q1) at=50n"
  },
  {
   "name": "q2_at",
   "unit": "V",
   "on_unreached": "null",
   "spice": ".meas tran q2_at find v(xdiv.xm.q2) at=50n"
  },
  {
   "name": "q3_at",
   "unit": "V",
   "on_unreached": "null",
   "spice": ".meas tran q3_at find v(xdiv.xm.q3) at=50n"
  },
  {
   "name": "b1_at",
   "unit": "V",
   "on_unreached": "null",
   "spice": ".meas tran b1_at find v(xdiv.xm.b1) at=50n"
  },
  {
   "name": "b2_at",
   "unit": "V",
   "on_unreached": "null",
   "spice": ".meas tran b2_at find v(xdiv.xm.b2) at=50n"
  },
  {
   "name": "b3_at",
   "unit": "V",
   "on_unreached": "null",
   "spice": ".meas tran b3_at find v(xdiv.xm.b3) at=50n"
  },
  {
   "name": "tfb",
   "unit": "s",
   "on_unreached": "null",
   "spice": ".meas tran tfb trig v(fb) val=1.65 td=20n rise=1 targ v(fb) val=1.65 td=20n rise=4"
  }
 ],
 "corners": {
  "process": [
   {
    "name": "FAST",
    "sections": [
     {
      "lib": "libs.tech/ngspice/models/cornerMOShv.lib",
      "section": "mos_ff"
     },
     {
      "lib": "libs.tech/ngspice/models/cornerCAP.lib",
      "section": "cap_bcs"
     },
     {
      "lib": "libs.tech/ngspice/models/cornerHBT.lib",
      "section": "hbt_bcs"
     }
    ]
   }
  ],
  "temperature_c": [
   125
  ],
  "params": {
   "vddv": [
    2.97
   ]
  }
 },
 "options": {
  "timeout_s": 1800,
  "keep_artifacts": true,
  "osdi_preload": [
   "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/osdi/psp103.osdi"
  ]
 }
