XQ2 OUTN OUTP TAIL 0 npn13G2v Nx=1 El=1.0
XQ3 TAIL NBIAS TE 0 npn13G2v Nx=1 El=2.0
RTE TE 0 2k m=1
RREF VDD NBIAS 20.5k m=1
XQ4 NBIAS NBIAS RE 0 npn13G2v Nx=1 El=1.0
RRE RE 0 4k m=1
VSUP VDD 0 dc {vddv}
.save i(vsup)
VCT VCTRL 0 dc {vctrl}
.ic v(OUTP)={vddv+0.005} v(OUTN)={vddv-0.005}
BD vd 0 V=v(outp)-v(outn)
.include sg13g2_inductor_em.spice
* The prescaler input on the tank (gate G1 load): same instance, bias and start-up .ic as sim/vco-prescaler-load.
.include ../../../design/netlist/prescaler.spice
IRF vdd iref dc 50u
VMC mc 0 dc 0
X1 outp outn mc iref pdp pdn vdd 0 prescaler
.ic v(x1.hp)=3.2 v(x1.hn)=3.0 v(x1.x2.mp)=3.0 v(x1.x2.mn)=3.2
