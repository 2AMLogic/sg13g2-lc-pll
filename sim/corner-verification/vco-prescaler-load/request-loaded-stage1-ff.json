{
 "_comment": [
  "Gate G2 corner envelope, stage 1 of the spec C-grid: pinned sg13g2-vco (unmodified) with the prescaler input on the tank.",
  "Per corner: fosc_t40 = time of 30 periods of v(vd) = v(OUTP)-v(OUTN) (rising zero crossings 40 to 70, so f = 30 / fosc_t40); vpp = peak-to-peak over 10-20n; tst = first time v(vd) reaches +0.2 V from the 10 mV .ic kick (startup proxy, not the row 6 g_m / loss ratio).",
  "No limits are set on the requests: the record grades row 1 (4.5-5.5 GHz), row 7 (>= 0.40 Vpp) and the loaded-vs-unloaded shift."
 ],
 "netlist": "vco_loaded.spice",
 "netlist_source": "schematic",
 "engine": "ngspice",
 "backend": "batch",
 "models": {
  "pdk": "ihp-sg13g2"
 },
 "analysis": {
  "kind": "tran",
  "args": "1p 20n 0 2p"
 },
 "measurements": [
  {
   "name": "fosc_t40",
   "unit": "s",
   "spec_row": "1",
   "on_unreached": "null",
   "spice": ".meas tran fosc_t40 trig v(vd) val=0 rise=40 targ v(vd) val=0 rise=70"
  },
  {
   "name": "vpp",
   "unit": "V",
   "spec_row": "7",
   "spice": ".meas tran vpp pp v(vd) from=10n to=20n"
  },
  {
   "name": "tst",
   "unit": "s",
   "spec_row": "6",
   "on_unreached": "null",
   "spice": ".meas tran tst when v(vd)=0.2 rise=1"
  }
 ],
 "corners": {
  "process": [
   {
    "name": "mos_ff/cap_typ/hbt_typ",
    "sections": [
